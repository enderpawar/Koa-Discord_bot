# ── 필수 ────────────────────────────────────────────────────────────────
# Discord Developer Portal → Bot → Token
DISCORD_TOKEN=

# Azure Speech 리소스 키와 리전 (예: koreacentral, eastus)
# 둘 중 하나라도 비어 있으면 TTS 기능이 비활성화된다.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ── 데이터 경로 ─────────────────────────────────────────────────────────
# Docker 배포 시에는 Dockerfile 의 ENV 가 /data 볼륨을 가리키므로 생략 가능.
# 로컬 실행 시 미지정이면 repo root 에 생성된다.
# CONFIG_PATH=config.json
# RANK_PATH=rank_stats.json
# PARTY_DB_PATH=party.db

# ── 로깅 / 개발 ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# compose 없이 직접 실행하면서 별도 bgutil PO Token provider를 운영할 때만 지정.
# docker-compose.yml은 내부 서비스 주소를 자동 주입한다.
# YOUTUBE_PO_TOKEN_PROVIDER_URL=http://127.0.0.1:4416

# 지정 시 해당 길드에만 슬래시 명령을 즉시 sync (전역 sync 는 캐시 1시간).
# 개발용. 프로덕션에서는 비워 두고 전역 sync 를 쓴다.
# TEST_GUILD_ID=

# ── 웹 어드민 (선택) ────────────────────────────────────────────────────
# 서버에서 `/관리자 대시보드`를 실행하면 Discord 관리자 권한을 확인하고
# 5분짜리 일회용 링크를 비공개로 발급한다. 고정 키나 마스터 키는 사용하지 않는다.
# ADMIN_WEB_ENABLED=1

# 일회용 토큰의 sha256 해시 저장 경로. 컨테이너는 Dockerfile 이
# /data/admin_login.sqlite3 으로 지정한다. 토큰 원문은 저장하지 않는다.
# ADMIN_LOGIN_DB_PATH=admin_login.sqlite3

# docker-compose.yml 로 띄우면 compose 가 0.0.0.0 으로 못박으므로 적을 필요가 없다.
# compose 없이 직접 python bot.py 로 띄울 때만 지정한다. 미지정이면 127.0.0.1 에
# 바인딩되어 외부에서 접속할 수 없다.
# ADMIN_WEB_HOST=0.0.0.0
# ADMIN_WEB_PORT=8080

# 봇이 사용자에게 안내하는 대시보드 주소. 미지정이고 HOST 가 0.0.0.0 이면
# 안내 링크가 표시되지 않는다.
# https:// 로 지정하면 세션 쿠키에 Secure 가 자동으로 붙는다.
# ADMIN_WEB_PUBLIC_URL=http://<서버IP>:8080

# 도메인이 없어 Cloudflare 임시 터널을 쓰는 경우, 봇이 현재 주소를 물어볼 곳.
# docker-compose.yml 의 cloudflared 서비스가 띄우며 compose 가 값을 주입한다.
# ADMIN_WEB_PUBLIC_URL 이 설정돼 있으면 그쪽이 우선한다.
# CLOUDFLARED_METRICS_URL=http://cloudflared:2000

# 리버스 프록시가 TLS 를 끊고 봇에는 평문으로 넘기는 구성이면 직접 켠다.
# 평문 HTTP 로 직접 서비스하면서 켜면 브라우저가 쿠키를 저장하지 않아
# 로그인이 무한 반복되므로 주의.
# ADMIN_WEB_COOKIE_SECURE=1

# 로그인 남용 억제는 출발지 IP 별로 실패를 센다. Cloudflare Tunnel 뒤에서는
# 봇이 보는 IP 가 모든 사용자에게 cloudflared 컨테이너 하나로 같아지므로,
# 실제 사용자 IP(CF-Connecting-IP)를 쓰려면 신뢰할 직전 홉을 여기 등록한다.
# IP 또는 CIDR 을 콤마로 구분. 비워 두면 어떤 전달 헤더도 신뢰하지 않는다
# (그래도 유효한 로그인 링크가 막히는 일은 없다 — cogs/web_admin_cog.py 참고).
# ADMIN_WEB_TRUSTED_PROXIES=172.16.0.0/12

# 대시보드 마크업은 templates/admin_login.html, templates/admin_dashboard.html 이다.
# 기본값은 프로세스 시작 시 1회만 읽는다. 아래를 켜면 매 요청 다시 읽어, 봇을
# 재시작하지 않고 화면 수정을 바로 확인할 수 있다 (개발용).
# ADMIN_WEB_TEMPLATE_RELOAD=1

# ── OCI Always Free 유휴 회수 방지 (선택) ──────────────────────────────
# docker-compose.yml 의 mem-anchor 서비스가 사용. Oracle Always Free A1
# 인스턴스가 아니면(로컬 등) 무관 — docs/deploy-oracle.md §0 참고.
# 인스턴스 총 메모리(12GB)의 20% 이상을 유지해야 하므로 2.4GB 미만으로 낮추지 말 것.
# MEM_ANCHOR_BYTES=2600000000
# 전체 할당 영역을 다시 만지는 주기(초). 기본값 30.
# MEM_ANCHOR_INTERVAL_SEC=30

# ── TTS 튜닝 (선택 · 기본값 권장) ───────────────────────────────────────
# 합성 백엔드: ws(기본, 지연 낮음) | rest
# TTS_BACKEND=ws
# TTS_WS_POOL_SIZE=2
# 두 합성 슬롯을 모두 워밍해 연속 입력 후에도 cold slot을 고르지 않게 합니다.
# TTS_WS_POOL_WARM_ALL=1
# TTS_WS_HEARTBEAT_SEC=5
# TTS_KEEPALIVE_INTERVAL_SEC=8
# TTS_KEEPALIVE_CHECK_INTERVAL_SEC=1
# TTS_KEEPALIVE_TEXT=가
# TTS_PRE_ROLL_MS=120
# TTS_MAX_QUEUE_SIZE=20
# 3초보다 오래 밀린 문장은 읽지 않고 최신 채팅을 따라잡습니다. 0이면 비활성화.
# TTS_MAX_QUEUE_AGE_SEC=3
# Azure가 발화 뒤에 붙이는 긴 무음을 제거해 연속 메시지 누적 지연을 막습니다.
# TTS_TRIM_SILENCE=1
# -58dBFS 부근의 매우 작은 신호까지 발화로 보존합니다.
# TTS_SILENCE_RMS_THRESHOLD=40
# 자연스러운 시작/끝을 위해 남기는 무음 길이(20ms 프레임 단위).
# TTS_SILENCE_LEADING_PAD_MS=20
# TTS_SILENCE_TRAILING_PAD_MS=160
# 0이면 TTS 끄기 또는 /퇴장 전까지 음성 채널 연결을 유지합니다.
# TTS_IDLE_DISCONNECT_SEC=0
# TTS_VOICE_CONNECT_TIMEOUT_SEC=10
# TTS_VOICE_RECONNECT_GRACE_SEC=8
# TTS_VOICE_CONNECT_ATTEMPTS=3
# TTS_VOICE_CONNECT_RETRY_DELAY_SEC=0.5
# 수동 RTP 무음 패킷은 AudioPlayer와 경합할 수 있어 기본 비활성화합니다.
# TTS_VOICE_SILENCE_KEEPALIVE_SEC=0
# TTS_VOICE_MEDIA_STABILIZE_SEC=0.25
# TTS_VOICE_MEDIA_READY_TIMEOUT_SEC=8
# TTS_VOICE_PLAYBACK_ATTEMPTS=2
# TTS_CACHE_MAX_ENTRIES=256
# TTS_CACHE_MAX_BYTES=33554432
# TTS_CACHE_MAX_ITEM_BYTES=524288
# TTS_OPUS_CACHE_MAX_BYTES=16777216

# ── 파티 티어 뱃지 ──────────────────────────────────────────────────
# 모집 제목에 게임 이름이 있으면(롤·발로란트) 참가자 줄에 티어를 붙인다.
# 별도 키가 필요 없다 — RIOT_API_KEY / VALORANT_API_KEY 를 그대로 쓴다.
# 서버별로 끄는 것은 관리자 대시보드에서 한다.
#
# 조회 결과를 굳혀 두는 파일. Docker 는 /data 볼륨으로 덮어쓴다.
# TIER_CACHE_PATH=tier_cache.json
#
# 캐시를 믿는 시간. 짧게 잡을수록 티어가 빨리 갱신되지만 API 호출이 늘어난다.
# TIER_CACHE_TTL_HOURS=24
#
# 티어 그림을 게임사 공식 아이콘으로 바꾸려면 한 번만 실행한다(선택):
#   python scripts/sync_tier_emojis.py            # 롤 11개 + 발로란트 26개
#   python scripts/sync_tier_emojis.py --dry-run  # 대상만 확인
# 안 올리면 유니코드 이모지로 표시된다.

# ── 발로란트 전적 조회 (/발로란트 등록 · 전적 · 검색) ──────────────────
# 라이엇 공식 VAL API 는 개인 키로 쓸 수 없어 커뮤니티 표준인 HenrikDev API 를
# 쓴다. https://discord.com/invite/X3GaVkX2YN 가입·인증 후 #get-a-key 에서
# "VALORANT (Basic Key)"를 선택하면 즉시 발급된다.
# 미설정이면 /발로란트 명령이 '설정 필요'로 응답한다.
# VALORANT_API_KEY=
#
# lookup 에서 리전 생략 시 기본값. eu | na | ap | kr | latam | br
# VALORANT_DEFAULT_REGION=kr
#
# 등록된 라이엇ID 매핑 저장 경로 (미지정 시 repo root / Docker 는 /data).
# VALORANT_STORE_PATH=valorant_ids.json

# ── 롤 전적 조회 (/롤 등록 · 전적 · 검색) ───────────────────────────────
# Riot 공식 API 키. https://developer.riotgames.com 에서 발급.
#   · 개발용(Development) 키: 로그인 시 발급되나 24시간마다 갱신 필요.
#   · 계속 운영할 봇: 프로젝트 등록 후 Personal 또는 Production 키 승인 필요.
# 미설정이면 /롤 명령이 '설정 필요'로 응답한다.
# RIOT_API_KEY=
# Riot 엣지가 일반 Python 클라이언트를 차단하지 않도록 제품 User-Agent를 보낸다.
# RIOT_API_USER_AGENT=KoaBot/1.0
#
# lookup 에서 지역 생략 시 기본 플랫폼. kr | jp1 | na1 | euw1 | eun1 | br1 | ...
# LOL_DEFAULT_PLATFORM=kr
#
# 등록된 라이엇ID 매핑 저장 경로 (미지정 시 repo root / Docker 는 /data).
# LOL_STORE_PATH=lol_ids.json
