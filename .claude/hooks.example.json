{
  "_comment": "이 블록을 .claude/settings.local.json 의 'hooks' 키로 병합하면 자동 테스트 파이프라인이 활성화됩니다. PostToolUse는 편집된 파일에 대응하는 단위 테스트만 즉시 실행, SessionStart는 진행 상태 보고, Stop은 턴 종료 시 회귀 검사.",

  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/scripts/test_for_file.py",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/scripts/check_phase_status.py",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/scripts/run_all_unit_tests.py",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
